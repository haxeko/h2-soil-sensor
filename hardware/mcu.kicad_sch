  (text "ESP32-H2-WROOM-02C (4MB: -H4S de co OTA). Vdd 3.0-3.6V.\nModule da co RC tren EN (10k/1uF).\nStrapping: IO9=1 (R21, sheet UI) -> SPI boot; IO8=1 (R11).\nIO10/IO11 la LP GPIO: giu muc khi light-sleep tat mien TOP.\nADC1: IO1=SOIL (module), IO2=VBAT. Chan khac de trong."
    (at 20.32 27.94 0)
    (effects (font (size 1.524 1.524)) (justify left top))
    (uuid 031cb6b2-d931-5b35-8b4d-041227f9a437)
  )
