menu "H2 Soil Sensor"

    menu "Measurement & reporting"
        config SOIL_MEAS_PERIOD_S
            int "Measurement period (s)"
            range 30 86400
            default 900
            help
                Time between two measurements. 900 s = 15 min. Can be overridden at run time
                (value stored in NVS key "period_s").

        config SOIL_MAX_REPORT_INTERVAL_S
            int "Maximum interval between attribute updates (s)"
            range 60 86400
            default 3600
            help
                A value is pushed to the Matter data model when it changed by more than its
                threshold OR when this time elapsed since the last update.

        config SOIL_REPORT_DELTA_PCT
            int "Soil moisture report threshold (%)"
            range 0 50
            default 2

        config TEMP_REPORT_DELTA_CENTI
            int "Temperature report threshold (0.01 degC)"
            range 0 1000
            default 30

        config RH_REPORT_DELTA_CENTI
            int "Air humidity report threshold (0.01 %RH)"
            range 0 2000
            default 200

        config VBAT_REPORT_DELTA_MV
            int "Battery voltage report threshold (mV)"
            range 0 500
            default 30

        config SOIL_SETTLE_MS
            int "Soil module settling time after VSENS on (ms)"
            range 50 10000
            default 1500
            help
                Capacitive soil modules (v1.2/v2.0, DFRobot SEN0193 and clones) need about 1 s
                after power-up before AOUT is stable (oscillator + peak detector / RC output).
                The SoC light-sleeps during this time; the module itself draws ~5 mA.

        config SOIL_MODULE_MIN_MV
            int "AOUT below this value = soil module missing (mV)"
            range 0 1000
            default 200

        config SOIL_ADC_SAMPLES
            int "ADC samples per channel (averaged, trimmed mean)"
            range 8 512
            default 64
    endmenu

    menu "Calibration"
        config SOIL_CAL_DRY_MV_DEFAULT
            int "Default DRY point (mV at AOUT, module in air)"
            default 2500
            help
                Typical capacitive modules at 3.3 V give ~2.4-2.8 V in air and ~1.0-1.4 V in
                water. Calibrate every module with the button (double click = dry,
                triple click = wet); the values are stored in NVS.

        config SOIL_CAL_WET_MV_DEFAULT
            int "Default WET point (mV at AOUT, module in water)"
            default 1200

        config SOIL_TEMP_COMP_UV_PER_C
            int "Soil reading temperature coefficient (uV/degC at AOUT, 0 = off)"
            range -20000 20000
            default 0
            help
                Optional first-order temperature compensation using the NTC probe:
                v_corr = v - k * (T - 25 degC). Measure k for your module in a pot of soil
                (e.g. fridge vs. room temperature) before enabling it.
    endmenu

    menu "Hardware options"
        config SOIL_ENABLE_NTC
            bool "Soil temperature: 10k NTC probe on J7"
            default y
            help
                Waterproof 10k NTC probe (2 wires, any polarity). If it is not plugged in at
                power-up, the temperature cluster is not created (see SOIL_OPTIONAL_EP_AUTO).

        config NTC_R25_OHM
            int "NTC resistance at 25 degC (ohm)"
            depends on SOIL_ENABLE_NTC
            default 10000

        config NTC_BETA
            int "NTC beta constant B25/50 (K)"
            depends on SOIL_ENABLE_NTC
            default 3950

        choice SOIL_AIR_SENSOR
            prompt "Air temperature/humidity module on J6 (I2C)"
            default SOIL_AIR_SENSOR_AUTO
            config SOIL_AIR_SENSOR_AUTO
                bool "Auto-detect (AHT20 0x38, SHT4x 0x44, SHT3x 0x44/0x45)"
            config SOIL_AIR_SENSOR_SHT4X
                bool "Sensirion SHT40/SHT41/SHT45 module"
            config SOIL_AIR_SENSOR_SHT3X
                bool "Sensirion SHT30/SHT31/SHT35 module (GY-SHT31-D ...)"
            config SOIL_AIR_SENSOR_AHT20
                bool "Aosong AHT20/AHT21 module"
            config SOIL_AIR_SENSOR_NONE
                bool "None"
        endchoice

        config SOIL_AIR_SENSOR_ENABLED
            bool
            default n if SOIL_AIR_SENSOR_NONE
            default y

        config SOIL_OPTIONAL_EP_AUTO
            bool "Create NTC / air endpoints only for sensors found at power-up"
            default y
            help
                The first measurement runs before the Matter data model is built. Sensors that
                do not answer then get no endpoint/cluster, so the controller shows no empty
                tiles. Plug the modules in before powering the device (re-commission if the
                set of sensors changes later).

        config SOIL_ENABLE_RH_MIRROR
            bool "Expose soil moisture also as a Humidity Sensor endpoint (Apple/Google compatibility)"
            default y

        config VBAT_DIVIDER_RATIO_X1000
            int "Battery divider ratio x1000 (R7+R8)/R8"
            default 2000

        config NTC_SUPPLY_MV
            int "NTC divider supply voltage (VSENS, mV)"
            default 3300

        config VBAT_SHUTDOWN_MV
            int "Battery cut-off: below this the device shuts down (mV, 0 = never)"
            default 2050

        config THREAD_TX_POWER_DBM
            int "802.15.4 TX power (dBm)"
            range -24 20
            default 10
            help
                ESP32-H2 draws ~140 mA at +20 dBm and ~60 mA at +9 dBm. +10 dBm is a good
                compromise for an outdoor sensor near a Thread router.
    endmenu

    menu "GPIO map (ESP32-H2-WROOM-02C)"
        config GPIO_SOIL_ADC
            int "SOIL_ADC (ADC1, soil module AOUT via 1k)"
            default 1
        config GPIO_VBAT_ADC
            int "VBAT_ADC (ADC1)"
            default 2
        config GPIO_NTC_ADC
            int "NTC_ADC (ADC1)"
            default 3
        config GPIO_SENS_PWR_EN_N
            int "SENS_PWR_EN_N (low = VSENS on)"
            default 10
        config GPIO_VBAT_MEAS_EN
            int "VBAT_MEAS_EN (high = divider on)"
            default 11
        config GPIO_I2C_SDA
            int "I2C SDA"
            default 12
        config GPIO_I2C_SCL
            int "I2C SCL"
            default 22
        config GPIO_LED
            int "Status LED (active high)"
            default 0
        config GPIO_BUTTON
            int "BOOT/USER button (active low, LP GPIO for wake-up)"
            range 8 14
            default 9
    endmenu

endmenu
